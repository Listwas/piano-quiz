{
  "name": "piano-quiz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "build": "node tools/build.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:update": "node tests/update.mjs",
    "test:viewport": "node tests/viewport.mjs",
    "deploy": "npm run build && node tools/deploy.mjs",
    "test:midi": "node tests/midi-browser.mjs",
    "test:training": "node tests/training-browser.mjs",
    "test:polish": "node tests/polish.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.127.1"
  }
}
